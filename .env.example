# Copy to .env and fill in. NEVER commit .env.

APP_NAME="Nithi Docket"
# local | production. In production the published default admin password is
# refused at seed time and must be changed at first login.
APP_ENV=production
# The site's public address with no trailing slash, e.g. https://yourname.example.com
# For local development use http://localhost:8090
APP_URL=http://localhost:8090
# Must be false on any real server: true prints stack traces to visitors.
APP_DEBUG=false
# Set to true ONLY if the site runs behind a reverse proxy / host load balancer
# that sets X-Forwarded-For and X-Forwarded-Proto (most PaaS hosts do). Leave
# false on plain Apache/Nginx or the PHP built-in server.
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nithi_docket
DB_USERNAME=root
DB_PASSWORD=

SESSION_LIFETIME_MINUTES=120
SESSION_NAME=nithi_docket_session

# Firebase Cloud Messaging (internal staff alerts) — leave FIREBASE_PROJECT_ID
# empty to run with notifications recorded as "failed: not configured".
# See /firebase/SETUP.md.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=firebase/service-account.json

# text.lk SMS gateway — the confirmation SMS to buyer/seller mobile numbers.
# See docs/SMS_SETUP.md. Leave TEXTLK_API_TOKEN empty to run with SMS
# recorded as "not configured" instead of failing hard.
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=

# First admin account, created once by `php database/seed_admin.php`.
# Choose a real password here (10+ characters); the published example
# "ChangeMe123!" is rejected when APP_ENV=production.
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
