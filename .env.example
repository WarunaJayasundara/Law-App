APP_NAME="Nithi Docket"
APP_ENV=local
APP_URL=http://localhost/nithi-docket/public
APP_DEBUG=true
APP_KEY=change-this-to-a-random-32-byte-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nithi_docket
DB_USERNAME=root
DB_PASSWORD=

SESSION_LIFETIME_MINUTES=120
SESSION_NAME=nithi_docket_session

# Firebase Cloud Messaging — leave FIREBASE_PROJECT_ID empty to run with
# notifications recorded as "failed: not configured" instead of crashing.
# See /firebase/SETUP.md for how to obtain these.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=firebase/service-account.json

# text.lk SMS gateway — real SMS to buyer/seller mobile numbers.
# See https://text.lk/docs/send-sms/. Leave TEXTLK_API_TOKEN empty to run
# with SMS recorded as "not configured" instead of failing hard.
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=

# Default admin account created by database/seed_admin.php (run once, then delete/rotate)
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
